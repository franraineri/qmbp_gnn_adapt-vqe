{
  "name": "Steering Context Injection",
  "version": "2.0.0",
  "description": "On every prompt, remind the agent of the single most critical constraint: do not modify stable modules.",
  "when": {
    "type": "promptSubmit"
  },
  "then": {
    "type": "askAgent",
    "prompt": "Reminder: Do NOT modify stable modules (config.py, hamiltonian_builder.py, classical_solver.py, hva_builder.py, pipeline_utils.py, vqe_optimizer.py) unless explicitly asked. Use pipeline_core.py for shared execution logic. Proceed with the user's request."
  }
}
