{
  "enabled": true,
  "name": "Auto-analyze extrapolation",
  "description": "After a large-N extrapolation run result JSON is created, automatically runs the analysis script to update the extrapolation_analysis.md report.",
  "version": "1",
  "when": {
    "type": "fileCreated",
    "patterns": [
      "results/experiments/exp_large_n_extrap/run_*.json"
    ]
  },
  "then": {
    "type": "runCommand",
    "command": ".venv/bin/python scripts/analysis/analyze_extrapolation_runs.py --after 20260812_000000",
    "timeout": 120
  }
}
