{
  "enabled": true,
  "name": "Notebook Binnacle Reminder",
  "description": "When a notebook is edited, remind to log results using the auto-registry with --binnacle --label for proper experiment documentation.",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "src/poc/v6/*.ipynb"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "A V6 notebook was just edited. Remind the user: when running this notebook, use the auto-registry for proper experiment documentation. Suggest the command: `python scripts/run_notebooks.py --binnacle --label \"brief description of what changed\"`. If the edit was to phases 1-2 only, suggest `--phase 1-2`. If phases 3-4, suggest `--phase 3-4`. This ensures all experiment runs are logged to documentation/binnacles/ with metrics, environment info, and run-to-run comparison. Do NOT run the notebook yourself — just provide the reminder."
  }
}
