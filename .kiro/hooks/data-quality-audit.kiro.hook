{
  "enabled": true,
  "name": "Data Quality Audit",
  "description": "Run the data quality analyzer on the ResultIndex to check for garbage entries, missing metadata, and report health metrics. Trigger periodically after batches of experiments.",
  "version": "1",
  "when": {
    "type": "userTriggered"
  },
  "then": {
    "type": "runCommand",
    "command": ".venv/bin/python project_health/cli/analyze_data_quality.py --verbose"
  }
}
