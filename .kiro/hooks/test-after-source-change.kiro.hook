{
  "name": "Test After Source Change",
  "version": "2.0.0",
  "description": "Run fast tests after source module changes to catch regressions immediately.",
  "when": {
    "type": "fileEdited",
    "patterns": ["src/qmbp_simulation/**/*.py"]
  },
  "then": {
    "type": "runCommand",
    "command": ".venv/bin/python -m pytest tests/ -x -q --tb=short -m 'not slow' 2>&1 | tail -5"
  }
}
