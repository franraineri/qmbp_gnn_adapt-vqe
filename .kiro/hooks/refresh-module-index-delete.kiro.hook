{
  "enabled": true,
  "name": "Refresh Module Index on Delete",
  "description": "Regenerates .kiro/steering/module-index.md when Python source files are deleted from src/, ensuring the index never contains phantom entries for removed functions.",
  "version": "1",
  "when": {
    "type": "fileDeleted",
    "patterns": [
      "src/**/*.py"
    ]
  },
  "then": {
    "type": "runCommand",
    "command": ".venv/bin/python scripts/general_project_maintenance/generate_module_index.py 2>/dev/null || .venv/bin/python scripts/maintenance/generate_module_index.py 2>/dev/null || true"
  }
}
