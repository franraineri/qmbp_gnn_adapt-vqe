# ── Whitelist: trained data we keep (tracked) ────────────────
!data/model_zoo/
# Metadata (manifest/registry/history) — always tracked
!data/model_zoo/*.json
# The "best" checkpoints referenced by the manifest (~29MB, needed after clone)
!data/model_zoo/checkpoints/
!data/model_zoo/checkpoints/*.pt
# Fallback checkpoints (defense-in-depth if a best checkpoint is missing)
!data/model_zoo/archived/
!data/model_zoo/archived/*.pt
# Local-only working dirs (versions/best/candidates/recovery) stay OUT of git
data/model_zoo/checkpoints/_*/
!data/multi_n_training/
!data/multi_n_training/*.npz
!data/ground_truth_cache.json
!data/eval_cache.json

# ── Whitelist: notebooks demo data (tracked for open-source) ─
!notebooks/
!notebooks/**
!notebooks/data/*.json
!notebooks/data/*.pt
!notebooks/*.ipynb

# ── Whitelist: results we keep ───────────────────────────────
!results/gnn_qem/
!results/gnn_qem/**
!results/H_EXPR_MATRIX.md
!results/H_FRONTIER_MODELS.md
!results/H_FRONTIER_TOPOLOGIES.md
!results/HVA_EXPRESSIBILITY_ANALYSIS.md
!results/.gitkeep

